# AI Development Team OS — 環境変数サンプル
# このファイルをコピーして .env を作成する
# .env は絶対にコミットしない

# Backend API
PORT=3000
# 未設定なら0.0.0.0(全interface、開発時デフォルト)。本番公開時は127.0.0.1を設定し、
# reverse proxy / tunnel経由でのみ到達可能にする
HOST=
# API authentication — 2つのmodeがあり、設定状態だけで自動的に切り替わる（コード側で判定）。
#
# legacy mode（両方未設定時）: API_TOKENのみを使う単一credential方式。全route許可。
# API_TOKENも空なら認証自体が無効になる（ローカル開発用）。
API_TOKEN=your_api_token_here
#
# split credential mode（ADMIN_TOKEN_SHA256 / WORKER_TOKEN_SHA256 を設定した場合）:
#   - ADMIN: 平文tokenをSHA-256した値のみをここへ書く（平文はVPS等のサーバー環境へ置かない。
#     CEO/operatorの手元にのみ平文を保持する）。全route許可
#   - WORKER: Worker runtimeが実際に使うJob poll/completion/Outbox/permission-grant/gate等の
#     許可route（`apps/api/src/auth/workerAllowlist.ts`）のみ許可。それ以外は403
#   - 必ず両方同時に設定すること。片方だけ設定、または両方に同じhash値を設定した場合は
#     「invalid configuration」として全requestが503になる（fail closed。設定ミスで
#     WorkerがADMIN権限へ昇格したり、認証がsilentに無効化されたりしない設計）
#   - WORKER runtime（Worker process）側の`API_TOKEN`には、ADMIN token平文ではなく
#     WORKER token平文を設定する（変数名は`API_TOKEN`のまま、値だけWORKER token）
# ADMIN_TOKEN_SHA256=
# WORKER_TOKEN_SHA256=
#
# Mobile app API URL
EXPO_PUBLIC_API_URL=http://localhost:3000

# Claude API（Developer AI / CTO AI / Context Manager AI）
CLAUDE_API_KEY=your_claude_api_key_here

# Gemini API（Meta Reviewer AI / Project Reviewer AI）
# 別プロバイダにすることで相関バイアスを排除する
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=

# OpenCode Go API (Approval / Task Failure explanation; API process only)
OPENCODE_GO_API_KEY=

# OpenAI API（Codex CLI — Developer AI サブプロバイダー）
# Claude Code が重い処理向き、Codex は局所的なコード編集向き
# 使わない場合は空のままでよい
OPENAI_API_KEY=your_openai_api_key_here

# GitHub
# GITHUB_TOKEN は git push、gh CLI、Copilot CLI（Meta Review の Gemini quota枯渇時フォールバック
# 用、apps/worker/src/metaReviewer/copilotRouter.ts）の3つで使用する
# gh CLI の認証: export GH_TOKEN=$GITHUB_TOKEN または gh auth login
# GitHub Actions では secrets 不要。${{ github.token }} をそのまま渡せる（PAT不要、実測確認済み）
GITHUB_TOKEN=your_github_token_here
GIT_USER_NAME=your_git_username
GIT_USER_EMAIL=your_git_email

# Sandbox
CONTROL_REPO_PATH=/srv/ai-team/softwareDevelopAIteam  # このリポジトリ（read-only mount）
TARGET_REPO_PATH=/srv/ai-team/repos/target-project    # AIが開発する対象（read-write mount）

# Control Repository Root（Meta Review Runner が docs/meta_reviewer/ を読み込む起点）
# Docker環境: 未設定のまま（runner.ts のデフォルト /workspace/control が使われる）
# Windowsローカル開発: このリポジトリの絶対パスを設定する
# 例: CONTROL_ROOT=C:\Users\yourname\softwareDevelopAIteam
CONTROL_ROOT=

# Worker
API_BASE_URL=http://localhost:3000
WORKER_POLL_INTERVAL_MS=5000
JOB_LOG_DIR=./data/logs
