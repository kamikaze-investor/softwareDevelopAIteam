# Names only. Copy to the path referenced by ai-team-tunnel-client.service (outside the repository
# checkout), chmod 600, and fill the values on the server. Never commit real values.
#
# OpenAI Platform runtime API key: Restricted, Tunnels Read + Use only. Never an admin key.
CONTROL_PLANE_API_KEY=
# tunnel_id from OpenAI Platform > Tunnels (scoped to the org and the ChatGPT workspace).
CONTROL_PLANE_TUNNEL_ID=
# Static header tunnel-client adds on requests to the gateway. The `env:` reference keeps
# the bearer out of argv and config; the value stays literally `Authorization: env:MCP_GATEWAY_AUTH`.
MCP_EXTRA_HEADERS=
# Same header for tunnel-client's startup / discovery probes, so they are not rejected with 401.
MCP_DISCOVERY_EXTRA_HEADERS=
# `Bearer <local bearer>`. MCP_LOCAL_BEARER_TOKEN_SHA256 in mcp-gateway.env is the SHA-256 of the
# bare <local bearer> only (no `Bearer ` prefix, no trailing newline: `printf %s "$T" | sha256sum`).
MCP_GATEWAY_AUTH=
