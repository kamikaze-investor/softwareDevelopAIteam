# Names only. Copy to the path referenced by ai-team-mcp-gateway.service (outside the repository
# checkout), chmod 600, and fill the values on the server. Never commit real values.
# Hashes are SHA-256 hex of the bare value with no trailing newline: `printf %s "$T" | sha256sum`.
#
# Plaintext OPERATOR_GATEWAY credential used for gateway -> AIteamOS API calls.
# The API holds only its SHA-256 (OPERATOR_GATEWAY_TOKEN_SHA256). Never an ADMIN or WORKER token.
AITEAMOS_OPERATOR_GATEWAY_TOKEN=
# Caller -> gateway authentication. `local_static_bearer` for the loopback Tunnel path.
MCP_EXTERNAL_AUTH_MODE=
# SHA-256 (hex) of the local bearer the tunnel-client sends. The plaintext lives only in tunnel-client.env.
MCP_LOCAL_BEARER_TOKEN_SHA256=
